# Адрес Yandex Cloud Function (API Gateway), выдающей pre-signed URL.
# См. YANDEX_STORAGE.md
VITE_PRESIGNER_URL=

# Объявления (блок «📢 Объявления» на главной + вкладка в админке).
# true — включить, пусто/false — отключить
VITE_ENABLE_ANNOUNCEMENTS=false

# Анимации вкладок админ-панели (motion). Диагностический флаг бага
# перерисовки на iOS Safari: false — рендерить вкладки админки без анимации
VITE_ADMIN_ANIMATIONS=false
